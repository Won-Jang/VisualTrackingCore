# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv-mac/
venv/
env/
ENV/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Test / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Local logs / temporary files
*.log
*.tmp
*.bak

# Downloaded MediaPipe model (downloaded automatically at runtime)
models/*.task
!models/.gitkeep

# Camera-specific calibration and locally generated print boards
calibration/*.npz
calibration/*.png
